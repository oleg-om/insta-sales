# Database
# Docker Compose: set these three; leave DATABASE_URL unset so the backend image builds it (same password as Postgres).
POSTGRES_USER=instasales
POSTGRES_PASSWORD=change-me
POSTGRES_DB=instasales
# Local dev (npm run dev on host, Postgres on localhost) — use this instead of POSTGRES_* above:
# DATABASE_URL=postgresql://instasales:change-me@localhost:5432/instasales

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Instagram OAuth
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3001/auth/instagram/callback

# Frontend URL (for backend redirects)
FRONTEND_URL=http://localhost:5173

# API URL for frontend (optional, defaults to relative URLs in production)
# VITE_API_URL=http://localhost:3001
